# Copy to ~/.bluesky_env and fill in. Loaded by lightning-bluesky.service
# and start_lightning.sh. Do NOT commit the real file (it contains your location).

# --- NOAA / NWS storm gate (required while NOAA_REQUIRED=true) ---
# Use a rounded location (2 decimal places, about 1 km) rather than your exact address.
NOAA_LAT=00.00
NOAA_LON=-00.00
# NWS asks for a User-Agent that includes contact info.
NOAA_USER_AGENT="LightningNode/1.0 (you@example.com)"
NOAA_REQUIRED=true
# Hourly forecast periods to scan for thunder (default 3).
NOAA_FORECAST_HOURS=3

# --- Posting policy (defaults shown) ---
# MAX_POSTS_PER_DAY=4
# MIN_POST_INTERVAL_S=10800
# CALM_WINDOW_S=7200
# LOCAL_TIMEZONE=America/Chicago

# --- Optional: other nodes ---
# GREENHOUSE_STATUS_URL=http://greenhouse-pi:5000/status
# RAIN_STATUS_URL=http://rain-node:5000/status

# --- Force dry run on/off (overrides [app] dry_run in ~/.bluesky_credentials.ini) ---
# LIGHTNING_DRY_RUN=true
