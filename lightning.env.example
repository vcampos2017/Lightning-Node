# Copy to ~/.bluesky_env and fill in. Loaded by lightning-bluesky.service
# and start_lightning.sh. Do NOT commit the real file (it contains your location).

# --- NOAA / NWS storm gate (required while NOAA_REQUIRED=true) ---
# Use a rounded location (2 decimal places, about 1 km) rather than your exact address.
NOAA_LAT=00.00
NOAA_LON=-00.00
# NWS asks for a User-Agent that includes contact info.
NOAA_USER_AGENT="LightningNode/1.0 (you@example.com)"
NOAA_REQUIRED=true
# Hourly forecast periods to scan for thunder (default 3).
NOAA_FORECAST_HOURS=3

# --- Posting policy (defaults shown) ---
# MAX_POSTS_PER_DAY=4
# MIN_POST_INTERVAL_S=10800
# CALM_WINDOW_S=7200
# LOCAL_TIMEZONE=America/Chicago

# --- Optional: other nodes ---
# GREENHOUSE_STATUS_URL=http://greenhouse-pi:5000/status
# RAIN_STATUS_URL=http://rain-node:5000/status

# --- Force dry run on/off (overrides [app] dry_run in ~/.bluesky_credentials.ini) ---
# LIGHTNING_DRY_RUN=true

# --- Node network: check in with Chatty over MQTT ---
# Posts chatty/nodes/lightning/status (heartbeat) and .../data (strike counts,
# last strike, and whether the sensor is connected). Needs paho-mqtt in the venv.
# MQTT_HOST=chatty-node.local
# Chatty is found on any WiFi (broker_link.py): her home address, the name
# above, then Tailscale. MQTT_HOSTS=a,b,c to give the whole list yourself.
# MQTT_TAILSCALE=100.69.130.79
# MQTT_SCAN=0              # never knock around the home network
# MQTT_PORT=1883
# NODE_NAME=lightning
# LIGHTNING_MQTT=0          # turn it off

# --- AS3935 tuning (fewer false detections) ---
# The node keeps running (and stays online for Chatty) with the sensor unplugged,
# and picks it back up within AS3935_RETRY_S seconds once it answers again.
# AS3935_INDOORS=false      # true if the sensor sits inside the house
# AS3935_NOISE_FLOOR=1      # 0-7; raise it if the log shows lots of "Noise level too high"
# AS3935_TUN_CAP=1          # 0-15; MOD-1016 boards ship with their value on a sticker/bag
# AS3935_MIN_STRIKES=5      # 1, 5, 9 or 16
# AS3935_WATCHDOG=3         # 0-15; raise it if motors/switches trigger "lightning"
# AS3935_SPIKE_REJECT=3     # 0-15; same idea, rejects short spikes
# AS3935_MASK_DISTURBERS=false
# AS3935_RETRY_S=60
